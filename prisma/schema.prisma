// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  sessions        Session[]
  accounts        Account[]
  Note            Note[]
  FavoriteNote    FavoriteNote[]
  FavoriteCanvas  FavoriteCanvas[]
  NoteShare       NoteShare[]
  subscription    Subscription?
  UserPlusInfo    UserPlusInfo?
  PasswordManeger PasswordManeger[] 
  Canvas          Canvas[]
  CanvasShare     CanvasShare[]
  sifaloPayments  SifaloPayment[]
  // false = the owner chose not to receive new note/board shares from anyone
  allowSharing    Boolean          @default(true)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Note {
  id          String         @id
  title       String
  description String
  body        NoteBody? // optional relation to NoteBody
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  user        User           @relation(fields: [userId], references: [id])
  userId      String
  category    String[]
  favorites   FavoriteNote[] // relation to favorite notes
  shares      NoteShare[] // ملاحظة مشتركة مع مستخدمين آخرين
}

model NoteBody {
  id         String   @id @default(uuid())
  contentEnc String? // Encrypted (AES-256-GCM) note payload: iv + authTag + ciphertext (base64). Contains content + links.
  images     String[] // Cloudinary URLs (public CDN assets, stored separately for cleanup)
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId     String   @unique
}

model FavoriteNote {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId    String
  createdAt DateTime @default(now())

  @@unique([userId, noteId]) // لضمان عدم تكرار نفس الملاحظة كمفضلة لنفس المستخدم
  @@map("favorite_note")
}

model NoteShare {
  id         String   @id @default(uuid())
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  permission String   @default("read") // "read" | "write"
  isRead     Boolean  @default(false) // has the recipient opened the note yet
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([noteId, userId]) // منع تكرار نفس المشاركة لنفس المستخدم
  @@map("note_share")
}

model Subscription {
  id        String    @id @default(uuid())
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true) // <-- new field
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Server-created checkout/financial record for Sifalo Pay hosted checkout.
// A SifaloPayment is created (session-authenticated) when a checkout starts.
// The sid is only attached after the payment is verified with Sifalo (verify.php),
// and the unique sid is the idempotency guard against re-fulfilment.
model SifaloPayment {
  id        String    @id @default(uuid())
  userId    String
  amount    String
  currency  String    @default("USD")
  status    String    @default("pending") // pending | paid
  sid       String?   @unique
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model UserPlusInfo {
  id      String @id @default(uuid())
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String @unique
  gender  String
  country String
}

model PasswordManeger {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   
  title       String
  description String
  emailOruser String
  password    String
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Canvas {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  title      String   @default("Untitled board")
  contentEnc String? // AES-256-GCM encrypted Excalidraw scene
  shares     CanvasShare[] // لوحات مشتركة مع مستخدمين آخرين
  favorites  FavoriteCanvas[] // relation to favorite boards
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([userId])
}

model FavoriteCanvas {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  canvasId  String
  createdAt DateTime @default(now())

  @@unique([userId, canvasId]) // منع تكرار نفس اللوحة كمفضلة لنفس المستخدم
  @@map("favorite_canvas")
}

model CanvasShare {
  id         String   @id @default(uuid())
  canvas     Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  canvasId   String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  permission String   @default("read") // "read" | "write"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([canvasId, userId])
  @@map("canvas_share")
}
